{
  "manifest_version": 3,
  "name": "Orchords Web Pilot",
  "short_name": "Web Pilot",
  "version": "0.1.0",
  "description": "Connect your Chrome or Edge browser to Orchords Web Pilot.",
  "permissions": ["activeTab", "nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Orchords Web Pilot"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
