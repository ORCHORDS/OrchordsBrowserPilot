# Transport mode for the MCP server: "stdio" (default) or "http".
PILOT_TRANSPORT=stdio

# HTTP transport options (ignored unless PILOT_TRANSPORT=http).
PILOT_HTTP_HOST=127.0.0.1
PILOT_HTTP_PORT=8788
PILOT_HTTP_PATH=/mcp

# HTTP hardening (issue #43). Defaults are safe for localhost:
#  - Origins: loopback variants of the bound host are always allowed; add
#    explicit origins (comma-separated) when a browser client is expected.
#  - Public binds are REFUSED unless you opt in. Front the server with an
#    authenticating reverse proxy before exposing it beyond localhost.
# PILOT_HTTP_ALLOWED_ORIGINS=https://myapp.example.com
# PILOT_HTTP_ALLOWED_HOSTS=myapp.example.com
# PILOT_HTTP_RATE_LIMIT=120          # requests per minute per client IP
# PILOT_HTTP_MAX_BODY_KB=1024        # reject larger JSON bodies
# PILOT_HTTP_REQUEST_TIMEOUT_SEC=60  # hard per-request timeout
# PILOT_HTTP_TRUST_PROXY=false       # enable X-Forwarded-For processing only behind trusted peers
# PILOT_HTTP_TRUSTED_PROXIES=127.0.0.1,::1  # exact reverse-proxy socket IPs; required when trust proxy is true
# PILOT_HTTP_ALLOW_PUBLIC_BIND=false # refuse non-loopback binds unless true

# Browser session. If BROWSER_WS_ENDPOINT is set, the server connects to a
# remote browser (Browserless, hosted Chrome, etc.). Otherwise it launches
# a local Chromium via Playwright.
# BROWSER_WS_ENDPOINT=

# Optional: headless mode. Set PILOT_HEADLESS=false to see what the agent sees.
PILOT_HEADLESS=true

# Optional: captcha solver hook. The MVP logs a TODO; provide your solver URL.
# PILOT_CAPTCHA_SOLVER_URL=
# PILOT_CAPTCHA_SOLVER_TOKEN=
